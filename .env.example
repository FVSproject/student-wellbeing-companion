# --- Database (Neon / Supabase / any Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Ably realtime (live session dashboard) ---
ABLY_API_KEY=

# --- Anthropic Claude API (server-side only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- OpenAI (Whisper for speech-to-text; optional in v1) ---
OPENAI_API_KEY=

# --- Cloudflare R2 (raw audio storage; optional) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Foundation admin whitelist (comma-separated emails) ---
# Users signing in with any of these emails are promoted to FOUNDATION_ADMIN
# on first login (or on any subsequent login if their role is out of sync).
ADMIN_EMAILS=

# --- Ingestion HMAC (device -> API auth; generated per session) ---
INGEST_SIGNING_SECRET=
